<article id="<%= post.layout %>-<%= post.slug %>" class="article article-type-<%= post.layout %>" itemscope itemprop="blogPost">
  <div class="article-meta">
    <%- partial('post/date', {class_name: 'article-date', date_format: null}) %>
    <!-- <%- partial('post/category') %> -->
  </div>
  <div class="article-inner">
    <%- partial('post/gallery') %>
    <% if (post.link || post.title){ %>
      <header class="article-header-single">
        <%- partial('post/title', {class_name: 'article-title'}) %>
      </header>
      <div class="article-share">
        Last Update:
        <%- partial('post/lastupdate', {class_name: 'article-date-single', date_format: null}) %>
      </div>
    <% } %>
    <div class="article-entry" itemprop="articleBody" style="overflow-wrap: break-word">
      <% if (post.excerpt && index){ %>
        <%- post.excerpt %>
        <% if (theme.excerpt_link){ %>
          <p class="article-more-link">
            <a href="<%- url_for(post.path) %>#more"><%= theme.excerpt_link %></a>
          </p>
        <% } %>
      <% } else if (index) { %>
        <%- post.content.replace(/<(".*?"|'.*?'|[^'"])*?>/g, "").substr(0, 400) + "..."%>
        <p class="article-more-link">
          <a href="<%- url_for(post.path) %>#more"><%= theme.excerpt_link %></a>
        </p>
      <% } else { %>
        <% const tocConfig = Object.assign({}, config.toc, post.toc); %>
        <% if (tocConfig.enabled) { %>
          <details class="article-toc" open>
            <summary class="article-toc-title">この記事の内容</summary>
            <%- toc(post.content, {
              min_depth: post.min_depth || 1,
              max_depth: post.max_depth || 6,
              list_number: post.list_number !== false
            }) %>
          </details>
        <% } %>
        <%- post.content %>
      <% } %>
    </div>
    <footer class="article-footer">
      <a data-url="<%- post.permalink %>" data-id="<%= post._id %>" class="article-share-link"><%= __('share') %></a>
      <% if (post.comments && config.disqus_shortname){ %>
        <a href="<%- post.permalink %>#disqus_thread" class="article-comment-link"><%= __('comment') %></a>
      <% } %>
      <%- partial('post/tag') %>
    </footer>
  </div>
  <% if (!index){ %>
    <%- partial('post/nav') %>
  <% } %>
</article>

<% if (!index && post.comments && config.disqus_shortname){ %>
<section id="comments">
  <div id="disqus_thread">
    <noscript>Please enable JavaScript to view the <a href="//disqus.com/?ref_noscript">comments powered by Disqus.</a></noscript>
  </div>
</section>
<% } %>