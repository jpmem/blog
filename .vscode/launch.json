{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "attach",
            "name": "Blog Site: Start & Attach",
            "port": 9229,
            "address": "localhost",
            "localRoot": "${workspaceFolder}",
            "remoteRoot": "/blog/",
            "skipFiles": [
                "<node_internals>/**",
                "${workspaceFolder}/node_modules/**",
                "/blog/node_modules/**"
            ],
            "preLaunchTask": "open local blog site",
            "postDebugTask": "docker stop"
        }
    ]
}